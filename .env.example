# Backend — docs/BACKEND.md §6. Copy to .env.local and fill in.
# Every var is optional in dev; features switch on as vars appear.

# Phase A — persistence (Hostinger MySQL, database `artors`)
DATABASE_URL=

# Phase B — email, sent through the Hostinger mailbox for artors.in.
# artors.in already publishes SPF, DKIM and DMARC for Hostinger mail,
# so mail relayed through this host authenticates as the real address.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ai@artors.in
SMTP_PASS=

# From: header. Must be the same mailbox as SMTP_USER or DMARC fails.
LEAD_FROM_EMAIL=ai@artors.in
LEAD_FROM_NAME=Artors

# Where the internal lead notification lands.
LEAD_NOTIFY_EMAIL=ai@artors.in

# Phase C — admin (docs/ADMIN.md §7).
# The password is stored ONLY as a scrypt hash. Generate one with:
#   npm run admin:hash -- 'your password'
ADMIN_EMAIL=ai@artors.in
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
SESSION_SECRET=

# Uploaded media. Outside public/, served by /api/media/[key].
UPLOAD_DIR=.uploads
